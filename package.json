{
  "name": "way1ong-games-puzzles",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Free, ad-free puzzle games by way1ong — no tracking, work offline.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "build": "vite build",
    "verify": "npm run typecheck && npm run test && npm run build",
    "preview": "vite preview",
    "build:claude": "node scripts/claude-page.mjs",
    "audit": "node scripts/audit.mjs",
    "check:live": "node scripts/check-live.mjs",
    "words:fetch": "node --experimental-strip-types --no-warnings scripts/words/fetch.ts",
    "words:build": "node --experimental-strip-types --no-warnings --max-old-space-size=4096 scripts/words/build.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  }
}
