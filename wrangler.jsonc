{
  // Cloudflare Workers with static assets: the games are the dist/ folder built by `npm run build`
  // (each game at /<game>/; the root leads to /blocks/ through games/public/_redirects).
  // The Worker name must match the name in the Cloudflare dashboard (Workers Builds) — docs/cloudflare.md.
  "name": "way1ong-games",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./dist"
  },
  // The games' own address (decision of 23.11). way1ong.eu is already a domain of this Cloudflare account,
  // so the next deploy from main creates the DNS record and the certificate itself — docs/cloudflare.md,
  // "Домен". The games tell players this address too: shared/core/address.ts (a test keeps them equal).
  "routes": [{ "pattern": "games.way1ong.eu", "custom_domain": true }],
  // With routes in this file a deploy switches the workers.dev address off unless it is kept on here.
  // It stays on while the games move to their domain; switching it off is a separate step.
  "workers_dev": true,
  // No public addresses for branch previews and versions: with workers_dev on they would be switched on
  // too, each carries the account's subdomain, and Cloudflare posts them into pull requests.
  "preview_urls": false,
  // Branches other than main: Workers Builds runs `npx wrangler preview` for them, and that command stops
  // when this block is missing (it may be empty) — docs/cloudflare.md, "Гілки: попередній перегляд".
  // A Preview is a separate copy of the games for one branch; the games on main are not touched.
  "previews": {}
}
